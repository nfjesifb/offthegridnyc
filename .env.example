# Copy to .env (git-ignored) and export these before running the local tools.

# Required by `npm run admin` (tools/admin_server.py). Use a long random passphrase.
OTG_ADMIN_PASSWORD=

# Only needed by tools/fetch_photos.py (Google Places API). The published site
# itself never needs a Google key: the map, street view and photos are key-free.
GOOGLE_PLACES_API_KEY=
